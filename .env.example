# AutoSynth-Bridge 环境变量配置

# ===== 旧模块配置（兼容）=====
API_4S_KEY=your-4sapi-key-here
API_4S_BASE=https://open.ai-api.cn/v1
POE_API_KEY=your-poe-api-key-here

# ===== V2 新主链配置 =====

# OpenAI-compatible Provider
OPENAI_COMPATIBLE_BASE_URL=https://open.ai-api.cn/v1
OPENAI_COMPATIBLE_API_KEY=your-4sapi-key-here
OPENAI_COMPATIBLE_MODEL=gpt-4.5-mini

# TrajectoryStore
AUTOSYNTH_TRAJECTORY_DIR=./trajectories
AUTOSYNTH_DB_PATH=./database/trajectories.db

# Provider 配置
AUTOSYNTH_PROVIDER_TIMEOUT=30
AUTOSYNTH_PROVIDER_RETRY=2

# DebateEngine
AUTOSYNTH_DEBATE_ROUNDS=3
AUTOSYNTH_CONSISTENCY_THRESHOLD=0.85
